# ---- Guestbook storage (pick one; none = messages stay in each visitor's browser) ----

# A) Supabase (works on GitHub Pages / any static host). Create a free project, run supabase/guestbook.sql,
#    then copy the Project URL and the publishable key (or legacy anon key) from Project Settings → API Keys.
#    For production builds (GitHub Pages) these live in the committed .env.production; set them here only to override.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# B) Node hosting (Vercel etc.): the built-in API route stores messages in Upstash Redis when set,
#    otherwise in data/guestbook.json on the server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a static build can post to an external copy of the API route instead (e.g. your Vercel URL)
NEXT_PUBLIC_GUESTBOOK_API=
